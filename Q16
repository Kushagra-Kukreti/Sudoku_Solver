class Solution {
public:
    int findDuplicate(vector<int>& nums) {
         unordered_map<int,int>mp;
         for(int i=0;i<nums.size();i++){
             mp[nums[i]]++;
         }
         int duplicate = nums[0];
         for(auto i:mp){
             if(i.second >1){
                 duplicate =i.first;
             }
         }
         return duplicate;
    }
};
